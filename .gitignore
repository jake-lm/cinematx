# Local config with real credentials — copy config.example.php to config.php and fill in
config.php

# Database backups may contain real data
*.sql

# Media uploads
motw/

# OS and editor
.DS_Store
*.swp
*.swo

# Local dev server log
.devserver.log

# Scrape lock files
list/*.lock

# Visitor counts
data/

# Scrape caches — written at runtime by the warmer, so tracking them
# means every deploy collides with the cron. warm-cache.php rebuilds them.
list/cache_*.json
